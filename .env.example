# ─── WHV Tax CRM — Environment Variables ─────────────────────────────────
# Copy to .env.local and fill in ALL values. NEVER commit .env.local to git.
# The app will throw an error at startup if any required variable is missing.

# ─── Supabase (REQUIRED for data persistence + file storage) ─────────────
# Get from: Supabase Dashboard → Settings → API
# NEXT_PUBLIC_SUPABASE_URL: e.g. https://xxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: long secret key - KEEP PRIVATE!
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Auth (REQUIRED — generate strong random values) ─────────────────────
# JWT_SECRET:      run:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# CRM_PASSWORD:    choose a strong password (min 16 chars, mixed case + symbols)
# PASSWORD_SALT:   run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
CRM_PASSWORD=
PASSWORD_SALT=

# (Reviewer portal env vars removed — the reviewer role is not implemented in code.)

# ─── Resend (email alerts + OTP delivery) ────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CRM_ADMIN_EMAIL=your@email.com
# Optional. Set to "true" to silence ONLY the WhatsApp connection health
# alert emails (e.g. while WhatsApp is intentionally paused) — does not
# affect the CRM login OTP email, which uses RESEND_API_KEY separately.
WA_HEALTH_ALERTS_DISABLED=false

# ─── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://workingholidaytax.com.au

# ─── Redis (Upstash) — REQUIRED for OTP + brute-force protection ──────────
# Free Upstash account: https://upstash.com
# Supports both REDIS_URL and KV_URL (Vercel Upstash integration uses KV_URL)
REDIS_URL=
# KV_URL=  # alternative — set one or the other

# ─── Google Reviews (Featurable) ─────────────────────────────────────────
# Widget ID from: https://featurable.com dashboard (Google Reviews widget)
NEXT_PUBLIC_FEATURABLE_ID=

# ─── WhatsApp Cloud API (direct Meta connection — no BSP) ────────────────
# CANONICAL names the code reads are WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID /
# META_APP_SECRET / META_VERIFY_TOKEN. The older aliases (WHATSAPP_ACCESS_TOKEN /
# WHATSAPP_APP_SECRET / WHATSAPP_WEBHOOK_VERIFY_TOKEN) are ALSO accepted as
# fallbacks, so either set works — but prefer the canonical names below.
# Until WHATSAPP_TOKEN + WHATSAPP_PHONE_NUMBER_ID are set, Will stays in safe
# "test mode" (nothing is sent). The Will health check turns RED if you set the
# token to go live but leave META_APP_SECRET / META_VERIFY_TOKEN unset.
#
# WHATSAPP_TOKEN:            System User token — Meta Business Suite → Users →
#                            System users → generate token. Scopes:
#                            whatsapp_business_messaging, whatsapp_business_management.
# WHATSAPP_PHONE_NUMBER_ID:  Meta App → WhatsApp → API Setup → Phone number ID.
# WHATSAPP_WABA_ID:          same screen — the WhatsApp Business Account ID.
# META_APP_SECRET:           Meta App Dashboard → Settings → Basic. Verifies
#                            inbound webhook signatures.
# META_VERIFY_TOKEN:         any random string YOU choose — enter the same value
#                            in Meta's webhook setup screen (Verify token).
# CRON_SECRET:               any random string YOU choose — authorizes the Vercel
#                            cron that drives /api/will/tick.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
CRON_SECRET=

# NEXT_PUBLIC_META_APP_ID / NEXT_PUBLIC_META_CONFIG_ID: safe to expose
# client-side (not secrets). Used only by the one-time connect page at
# /crm/whatsapp/connect to launch Meta's Embedded Signup flow.
# App ID: Meta App Dashboard → App settings → Basic.
# Config ID: Meta App Dashboard → Facebook Login for Business → Configurations.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# ANTHROPIC_API_KEY: used ONLY to personalise the acknowledgment line in the
# opening message (Section 10.1) — never to answer questions. See
# src/lib/ai-personalize.ts for the exact guardrails. Get a key from
# https://console.anthropic.com
ANTHROPIC_API_KEY=
