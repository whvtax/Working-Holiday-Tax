# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Build artifacts
tsconfig.tsbuildinfo
*.tsbuildinfo

# Local dev store. store-file.ts claimed this was gitignored; it was not.
# If Supabase env vars are ever absent, the app silently falls back to this
# file and writes real customer records AND the WhatsApp access token into it.
.data/

# Env files (real secrets never committed)
.env
.env.local
.env*.local

# Logs & OS droppings
npm-debug.log*
.DS_Store

# Testing and scan output
coverage/
test-results/
playwright-report/
blob-report/
.playwright-mcp/
*.sarif
semgrep-results/
.semgrep/

# Keys and local tooling
*.pem
*.key
.vercel/
