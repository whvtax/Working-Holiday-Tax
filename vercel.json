{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm ci",
  "regions": [
    "syd1"
  ],
  "functions": {
    "src/app/api/atlas/ella/action/route.ts": { "memory": 3008, "maxDuration": 800 },
    "src/app/api/atlas/ella/tick/route.ts": { "memory": 3008, "maxDuration": 800 }
  },
  "crons": [
    {
      "path": "/api/will/tick",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/will/orphan-sweep",
      "schedule": "23 17 * * *"
    },
    {
      "path": "/api/atlas/ella/tick",
      "schedule": "*/5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
